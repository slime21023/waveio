<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/2.1.0 https://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>wave-0.9.0-rc-distribution</id>
    <formats><format>zip</format></formats>
    <includeBaseDirectory>false</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/../../wave/target</directory>
            <outputDirectory>lib</outputDirectory>
            <includes><include>wave-0.1.0-SNAPSHOT.jar</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../../docs</directory>
            <outputDirectory>docs</outputDirectory>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../../_spec</directory>
            <outputDirectory>spec</outputDirectory>
            <includes>
                <include>wave-architecture.md</include>
                <include>wave-roadmap.md</include>
                <include>wave-api-compatibility.md</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../../examples</directory>
            <outputDirectory>examples</outputDirectory>
            <includes><include>README.md</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../wave-benchmarks</directory>
            <outputDirectory>benchmarks</outputDirectory>
            <includes><include>README.md</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}</directory>
            <outputDirectory>.</outputDirectory>
            <includes><include>DISTRIBUTION.md</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>
</assembly>
